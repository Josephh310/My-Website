---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { SITE_TITLE } from '../consts';
import { getBuildAvatarHash } from '../lib/avatar';

interface Props {
	title: string;
	description: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description } = Astro.props;

const avatarHash = await getBuildAvatarHash();
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- Favicons are generated from the Discord avatar; data-avatar-size marks them for live updates -->
{avatarHash && <meta name="discord-avatar" content={avatarHash} />}
<link rel="icon" type="image/png" href="/favicon.png" data-avatar-size="256" />
<link rel="icon" href="/favicon.ico" sizes="32x32" data-avatar-size="32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" data-avatar-size="256" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />

<!-- Twitter -->
<meta property="twitter:card" content="summary" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />

<ClientRouter />

<script>
	import { avatarUrl, fetchAvatarHash } from '../lib/discord';

	// Pages ship with the avatar from the last deploy. If it has changed on Discord since,
	// swap the live one into the favicons and headshot. Fetched once per full page load
	const liveHash = fetchAvatarHash().catch(() => null);

	// Runs on every client-side navigation too, since swapping in the new page restores the built URLs
	document.addEventListener('astro:page-load', async () => {
		const hash = await liveHash;
		const builtHash = document.querySelector<HTMLMetaElement>('meta[name="discord-avatar"]')?.content;
		if (!hash || hash === builtHash) return;

		for (const el of document.querySelectorAll<HTMLElement>('[data-avatar-size]')) {
			const size = Number(el.dataset.avatarSize);
			if (el instanceof HTMLImageElement) {
				el.removeAttribute('srcset');
				el.src = avatarUrl(hash, size, 'webp');
			} else if (el instanceof HTMLLinkElement) {
				el.href = avatarUrl(hash, size);
			}
		}
	});
</script>

<script is:inline>
	(function() {
		function getTheme() {
			return localStorage.getItem('theme') ||
				(window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
		}
		document.documentElement.setAttribute('data-theme', getTheme());

		document.addEventListener('astro:before-swap', function(e) {
			e.newDocument.documentElement.setAttribute('data-theme', getTheme());
		});
	})();
</script>
